# Copy this file to .streamlit/secrets.toml for local runs,
# or paste its contents (with real values) into
# Streamlit Community Cloud -> App -> Settings -> Secrets.
#
# NEVER commit the real secrets.toml file to GitHub.

[smtp]
host = "smtp.gmail.com"      # your SMTP server
port = 587
user = "your-email@gmail.com"
password = "your-app-password"   # use an App Password, not your real password
from = "your-email@gmail.com"    # optional, defaults to `user`

# Only needed if you enable "Use Claude to write the post" in the app
ANTHROPIC_API_KEY = "sk-ant-..."
